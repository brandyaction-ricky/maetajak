SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY
GATE_API_BASE_URL=https://api.gateio.ws
GATE_CHANNEL_ID=maetajak
# Gate Broker metrics (admin dashboard). No default: without GATE_BROKER_UID the sync reports NOT_CONFIGURED
# (GATE_BROKER_UID_REQUIRED). Keys may be omitted only when GATE_BROKER_UID is the connected Master's UID.
GATE_BROKER_UID=
GATE_BROKER_API_KEY=
GATE_BROKER_SECRET_KEY=
WORKER_ID=maetajak-worker-01
WORKER_VERSION=0.5.0
WORKER_PUBLIC_IP=YOUR_FIXED_PUBLIC_IPV4
TRADING_MODE=OBSERVE
RUN_READINESS_CHECK=false
POLL_INTERVAL_MS=5000
SYNC_INTERVAL_MS=5000
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
