[Unit]
Description=maetajak Gate.io copy trading worker
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/maetajak
Environment=MAETAJAK_ENV_FILE=/etc/maetajak/worker.env
ExecStartPre=/usr/bin/docker compose -f docker-compose.worker.yml run --rm copy-worker npm run worker:preflight
ExecStart=/usr/bin/docker compose -f docker-compose.worker.yml up -d --no-build
ExecStop=/usr/bin/docker compose -f docker-compose.worker.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
